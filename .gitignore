# 构建产物
build/
bench/
out/
build-*/
bin/
lib/

# vcpkg
vcpkg_installed/
vcpkg/buildtrees/
vcpkg/packages/
vcpkg/downloads/

# 编译中间文件
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk

# IDE / 编辑器
.vs/
.idea/
.vscode/
.cache/
*.user

# 日志 / 临时
*.log
*.tmp
*.bak
.DS_Store

# 本地运行时数据（Redis/MariaDB 数据目录，不入库）
# 注意：必须根锚定 /data/，否则会误伤 C++ 模块路径 server/.../include/mmo/data/
*.rdb
*.sock
/data/

# 工具脚本本地覆盖（保留模板，忽略本地覆盖）
scripts/verify/_local_override.sh

# 残留设备名文件，无法安全删除，忽略之
NUL

# WorkBuddy 工具元数据，非游戏源码
.workbuddy/

# 临时验证脚手架（一次性 .cpp/.o/.exe 探针，非游戏源码）
.tmp_gate/

# Godot 编辑器导入缓存（打开时自动重建）
client/.godot/

# godot-cpp 是第三方依赖（独立 git 仓库），不作为嵌套仓库提交
client/extensions/protocol_codec/godot-cpp/

# scons 构建缓存与残留对象
.sconsign.dblite
*.o.stale
*.stale
**/.sconsign.dblite

# 验证运行产物目录（977/295 个文件，非源码）
.verify_041/
.verify_res/

# 巨幅轮转基准日志（58MB+，重跑即生成）
bench/log_bench.log*
/cami-server-*.zip

# 会话内临时脚手架：下划线开头的产物（构建/测试/校验的中间输出，用完即弃）
/_*
