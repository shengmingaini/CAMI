Makefile
*.cmake
!CMakeLists.txt
!cmake/
# 自定义 vcpkg overlay triplet (CI release-only 构建用), 需入库
!cmake/triplets/*.cmake

# Docker
docker/data/

# Logs
*.log
logs/

# Config overrides
configs/local_*.yaml
configs/local_*.json

# Generated files
proto/flatbuffers/*_generated.h
proto/protobuf/*.pb.cc
proto/protobuf/*.pb.h

# Generated protobuf python stubs: COMMITTED so CI needs no runtime protoc.
# (Regenerated locally by verify/load_configs.py only when .proto changes; on CI the
#  committed stubs are imported directly, eliminating cross-platform protoc flakiness.)
# Only ignore the junk/empty backup dir, never the committed *.py stubs.
verify/_pb/_pb_bak/

# Local assistant memory (machine-specific absolute paths; not for team repo)
.workbuddy/

# Python caches
__pycache__/
*.pyc
*.pyo

# Machine / VM artifacts (Docker Desktop, local VM, workbuddy overview)
.com.docker.backend.exe.tail.txt
.docker-desktop.exe.tail.txt
.feature_state.json
.vm_init_tail.txt
overview.md
