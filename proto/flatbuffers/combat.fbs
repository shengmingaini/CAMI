// combat.fbs — 战斗/技能 (MsgID 域 0x3000)
//
// 设计依据：架构 §4.2.3 战斗模块「不直接操作角色数据，仅调用角色模块修改接口」。
// 客户端发送施法意图；服务器权威结算后广播结果。
// 版本: v1.0.0 (Day 3)

include "common.fbs";

namespace CAMI.Combat;

// 客户端 → 服务器：施法意图（高频但可靠，需服务器判定）
table SkillCastIntent {
  entity_id: uint64;       // 施法者（= 自身 player_id）
  skill_id: uint32;
  target_id: uint64;       // 0 = 无目标/自身
  aim_pos: CAMI.Common.Vec3; // 指向坐标（技能无需目标时）
  client_ts: uint64;       // 客户端施法时间戳（延迟补偿）
}

// 服务器 → 客户端：施法结果（成功/失败原因）
table SkillCastResult {
  intent_seq: uint32;      // 关联 SkillCastIntent 的 request_id
  result: CAMI.Common.SkillResultCode;
  cast_ts: uint64;         // 服务器判定时间戳
}

// 伤害事件（逐次命中；PVP 走批次结算，见架构 §4.2.3 法术批次）
table DamageEvent {
  source_id: uint64;
  target_id: uint64;
  amount: int32;
  dtype: CAMI.Common.DamageType;
  is_crit: bool;
  server_ts: uint64;
}

// Buff 应用/移除事件
table BuffEvent {
  target_id: uint64;
  buff_id: uint32;
  apply: bool;             // true=应用, false=移除
  remaining_ms: uint32;
  stacks: ubyte;
}

// 战斗结果汇总（击杀/死亡/脱战等广播给相关 AOI 作用域）
table CombatResult {
  subject_id: uint64;
  dead: bool;
  killer_id: uint64;       // dead=true 时有效
}
