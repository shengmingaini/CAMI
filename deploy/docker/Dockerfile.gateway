# deploy/docker/Dockerfile.gateway — Gateway 容器镜像
# 二进制由 `cmake --build build --target gateway` 产出至 build/bin/gateway（Ninja 单配置树，无 Release/ 子目录）。
FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/mmorpg
COPY build/bin/gateway /opt/mmorpg/gateway
COPY config /opt/mmorpg/config
# 端口对齐 config/network.json 的 network.gateway_port = 9000
EXPOSE 9000
ENTRYPOINT ["/opt/mmorpg/gateway"]
