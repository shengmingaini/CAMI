# deploy/docker/Dockerfile.control — ControlService 容器镜像
# 二进制由 `cmake --build build --target control` 产出至 build/bin/control。
FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/mmorpg
COPY build/bin/control /opt/mmorpg/control
COPY config /opt/mmorpg/config
# ControlService 第一版为进程内服务（节点表/配置下发），暂无对外监听端口
ENTRYPOINT ["/opt/mmorpg/control"]
